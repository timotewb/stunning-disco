// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TeamMember {
  id              String           @id @default(uuid())
  name            String
  role            String
  seniority       String
  tags            String           @default("[]")
  notes           String           @default("")
  isLeaving       Boolean          @default(false)
  hasLeft         Boolean          @default(false)
  baselineFte     Float            @default(1.0)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime         @default(now())
  matrixEntries   MatrixEntry[]
  workRequests    WorkRequest[]    @relation("RequestAssignee")
  primarySME      SMEAssignment[]  @relation("PrimarySME")
  backupSME       SMEAssignment[]  @relation("BackupSME")
  capacityChanges CapacityChange[]
}

/// An effective-dated change to a member's FTE.
/// `effectiveTo` null means an open-ended step change; when set, the change is a
/// bounded period that auto-reverts (e.g. reduced hours for three weeks).
/// Resolution: of all rows covering a date, the greatest `effectiveFrom` wins.
model CapacityChange {
  id            String     @id @default(uuid())
  teamMemberId  String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  fte           Float
  reason        String?
  notes         String?
  createdAt     DateTime   @default(now())
  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, effectiveFrom])
  @@index([teamMemberId, effectiveFrom])
}

/// Public holidays. Treated as working days with zero capacity (not excluded
/// days) so the capacity dip stays visible in weekly figures.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  date      DateTime @unique
  createdAt DateTime @default(now())
}

model Dimension {
  id          String          @id @default(uuid())
  name        String
  type        String          @default("skills")
  description String          @default("")
  nodes       DimensionNode[]
}

model DimensionNode {
  id             String          @id @default(uuid())
  dimensionId    String
  parentId       String?
  name           String
  orderIndex     Int             @default(0)
  dimension      Dimension       @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  parent         DimensionNode?  @relation("NodeChildren", fields: [parentId], references: [id])
  children       DimensionNode[] @relation("NodeChildren")
  matrixEntries  MatrixEntry[]
  smeAssignments SMEAssignment[]
}

model Snapshot {
  id             String          @id @default(uuid())
  timestamp      DateTime
  matrixEntries  MatrixEntry[]
  smeAssignments SMEAssignment[]
}

model MatrixEntry {
  id              String        @id @default(uuid())
  teamMemberId    String
  dimensionNodeId String
  snapshotId      String
  value           Int           @default(0)
  teamMember      TeamMember    @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  dimensionNode   DimensionNode @relation(fields: [dimensionNodeId], references: [id], onDelete: Cascade)
  snapshot        Snapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, dimensionNodeId, snapshotId])
}

model AllocationTypeConfig {
  id              String   @id @default(uuid())
  name            String   @unique
  color           String   @default("gray")
  /// When true, allocations of this type subtract from available capacity
  /// (leave, secondment) rather than counting as demand on the team.
  reducesCapacity Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model WorkRequest {
  id                  String       @id @default(uuid())
  title               String
  description         String?
  source              String       @default("planning")
  sourceDetail        String?
  type                String       @default("other")
  priority            String       @default("medium")
  status              String       @default("new")
  isDraft             Boolean      @default(false)
  effort              String?
  dateRaised          DateTime     @default(now())
  dateResolved        DateTime?
  requestorId         String?
  requestor           Contact?     @relation(fields: [requestorId], references: [id], onDelete: SetNull)
  assigneeId          String?
  assignee            TeamMember?  @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Allocation section — populated when the request is scheduled on the Timeline
  isAllocated         Boolean      @default(false)
  allocationType      String?
  allocationStartDate DateTime?
  allocationEndDate   DateTime?
  /// Fraction of the assignee's capacity this allocation consumes (1.0 = all of it).
  /// Relative to the person, so a 0.6 FTE member at 1.0 contributes 0.6 FTE.
  allocationFte       Float        @default(1.0)
  allocationNotes     String?
  // Metadata
  noteRef             String?
  tags                String       @default("[]")
  externalRef         String?
  dimensionNodeIds    String       @default("[]")
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  fulfilsDemands      RoleDemand[] @relation("DemandFulfilment")

  @@index([isAllocated, allocationStartDate, allocationEndDate])
  @@index([assigneeId, isAllocated])
  @@index([requestorId])
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  role      String?
  team      String?
  email     String?
  notes     String?
  requests  WorkRequest[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model RequestSourceConfig {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("gray")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model RequestTypeConfig {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("gray")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model RequestPriorityConfig {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("gray")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model RequestStatusConfig {
  id         String   @id @default(uuid())
  name       String   @unique
  color      String   @default("gray")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model RequestEffortConfig {
  id         String   @id @default(uuid())
  name       String   @unique
  value      String   @unique
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
}

model SeniorityConfig {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("gray")
  createdAt DateTime @default(now())
}

model SMEAssignment {
  id              String        @id @default(uuid())
  dimensionNodeId String
  primaryMemberId String
  backupMemberId  String?
  snapshotId      String
  dimensionNode   DimensionNode @relation(fields: [dimensionNodeId], references: [id], onDelete: Cascade)
  primaryMember   TeamMember    @relation("PrimarySME", fields: [primaryMemberId], references: [id], onDelete: Cascade)
  backupMember    TeamMember?   @relation("BackupSME", fields: [backupMemberId], references: [id])
  snapshot        Snapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([dimensionNodeId, snapshotId])
}

/// A programme of work in the forward pipeline. `confidence` filters what the
/// planning view shows; it never weights the FTE, so figures stay explainable.
model Initiative {
  id          String    @id @default(uuid())
  name        String
  description String    @default("")
  confidence  String    @default("committed")
  color       String    @default("indigo")
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

/// A deliverable within an initiative. Role demand attaches here and only here,
/// so there is a single place to look for any given number. Dates are optional
/// and used to default those of new demands.
model Project {
  id           String       @id @default(uuid())
  initiativeId String
  name         String
  notes        String       @default("")
  startDate    DateTime?
  endDate      DateTime?
  orderIndex   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  initiative   Initiative   @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  roleDemands  RoleDemand[]

  @@index([initiativeId])
}

/// An unstaffed ask: this much of this role, for this window.
///
/// `fte` is absolute (2.0 = two full-time people), unlike
/// `WorkRequest.allocationFte` which is a fraction of one named person's
/// capacity. The two are different quantities and are computed separately.
///
/// `role` is free text on purpose. Planning includes roles the team does not
/// employ yet, and demand against zero capacity is the hiring signal.
///
/// When `fulfilledByRequestId` is set the demand has been staffed by a real
/// person; the engine then counts that allocation and skips this row, so the
/// original plan stays visible without being counted twice.
model RoleDemand {
  id                   String       @id @default(uuid())
  projectId            String
  role                 String
  seniority            String?
  fte                  Float        @default(1.0)
  startDate            DateTime
  endDate              DateTime
  notes                String?
  fulfilledByRequestId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fulfilledByRequest   WorkRequest? @relation("DemandFulfilment", fields: [fulfilledByRequestId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([startDate, endDate])
}
